{
  "name": "snippets",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run deploy:dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply snippets --local",
    "db:migrate:remote": "wrangler d1 migrations apply snippets --remote",
    "dev": "react-router dev",
    "predeploy": "npm run release:remote-check",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:legacy": "node --import tsx scripts/import-legacy.ts",
    "lint": "eslint .",
    "preview": "npm run build && vite preview",
    "release:config": "node --import tsx scripts/check-release-config.ts",
    "release:remote-check": "node --import tsx scripts/remote-release-check.ts",
    "release:smoke": "node --import tsx scripts/smoke-release.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@bprogress/react": "^1.2.7",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "jose": "^6.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8",
    "remark-gfm": "^4.0.1",
    "scratchblocks-plus": "^2.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
